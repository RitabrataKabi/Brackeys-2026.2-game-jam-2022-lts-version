    - target: {fileID: 6922949372436679539, guid: f0dcafc436d6b1d4fb77cc2faa5eda9d,
        type: 3}
      propertyPath: m_text
      value: "A Brackeys Game Jam 2026.2 Submission.\n\nTheme interpretation - \"Trust
        No One\" was this years theme, and my interpretation for this game was that
        you cannot even trust me nor the game. \n\nThis was in huge part inspired
        from \"Cat Mario\" & \"Trees hate you!\"\n\nTotal Development was under 18
        hrs spread over 3 days, (I had initially forogotten about it :))"
      objectReference: {fileID: 0}
